# Bash minimal : pour les machines où zsh n'est pas le shell par défaut.
[[ $- != *i* ]] && return

HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignoreboth
shopt -s histappend

alias ll='ls -lh'
alias la='ls -lAh'

command -v starship >/dev/null && eval "$(starship init bash)"
command -v zoxide >/dev/null && eval "$(zoxide init bash)"
